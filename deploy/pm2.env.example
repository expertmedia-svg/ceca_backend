ENVIRONMENT=production
CORS_ORIGINS=https://ceca-dr.com,https://www.ceca-dr.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none
SEED_WORK_DATA=false
SESSION_HOURS=8
# Sans DATABASE_URL, SQLite est enregistré dans ceca.db à la racine du dépôt.
# PostgreSQL existant, si souhaité :
# DATABASE_URL=postgresql+psycopg://utilisateur:mot_de_passe_encode@127.0.0.1:5432/ceca
